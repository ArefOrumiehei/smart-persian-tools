{
  "name": "smart-persian-tools",
  "version": "1.0.0",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "README.fa.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
